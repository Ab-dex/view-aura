# ── Build stage ────────────────────────────────────────────────────────────────
FROM golang:1.25 AS builder

WORKDIR /src

# System deps for confluent-kafka-go (CGO)
RUN apt-get update && apt-get install -y \
    gcc \
    pkg-config \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy workspace first (for caching)
COPY go.work.api ./go.work

# Copy only API-related modules (important for caching + avoiding broken go.work deps)
COPY cmd/api/go.mod cmd/api/go.sum ./cmd/api/
COPY internal/app/go.mod internal/app/go.sum ./internal/app/
COPY internal/contract/go.mod ./internal/contract/
COPY internal/platform/go.mod internal/platform/go.sum ./internal/platform/
COPY internal/events/go.mod internal/events/go.sum ./internal/events/

COPY internal/modules/user/go.mod ./internal/modules/user/
COPY internal/modules/movie/go.mod ./internal/modules/movie/
COPY internal/modules/rating/go.mod ./internal/modules/rating/
COPY internal/modules/review/go.mod ./internal/modules/review/
COPY internal/modules/watchlist/go.mod ./internal/modules/watchlist/
COPY internal/modules/social/go.mod ./internal/modules/social/
COPY internal/modules/notification/go.mod ./internal/modules/notification/
COPY internal/modules/payment/go.mod ./internal/modules/payment/
COPY internal/modules/upload/go.mod ./internal/modules/upload/
COPY internal/modules/quota/go.mod ./internal/modules/quota/
COPY internal/modules/moderation/go.mod ./internal/modules/moderation/
COPY internal/modules/profile/go.mod ./internal/modules/profile/

# Sync workspace deps
RUN go work sync

# Copy full source
COPY . .

# Build (NO static linking)
RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/viewaura-api \
    ./cmd/api


# ── Runtime stage ───────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN useradd -m viewaura

WORKDIR /app

COPY --from=builder /bin/viewaura-api /app/viewaura-api
COPY --from=builder /src/internal/platform/config /app/config

USER viewaura

EXPOSE 8080 9090

ENTRYPOINT ["/app/viewaura-api"]