# ── Build stage ────────────────────────────────────────────────────────────────
FROM golang:1.25 AS builder

WORKDIR /src

RUN apt-get update && apt-get install -y \
    gcc \
    pkg-config \
    librdkafka-dev \
    && rm -rf /var/lib/apt/lists/*

COPY go.work go.work.sum ./

# Worker modules only
COPY cmd/worker/go.mod cmd/worker/go.sum ./cmd/worker/
COPY internal/platform/go.mod internal/platform/go.sum ./internal/platform/
COPY internal/events/go.mod internal/events/go.sum ./internal/events/
COPY workflows/go.mod workflows/go.sum ./workflows/

RUN go work sync

COPY . .

RUN CGO_ENABLED=1 GOOS=linux go build \
    -ldflags="-s -w" \
    -o /bin/viewaura-worker \
    ./cmd/worker


# ── Runtime stage ───────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y \
    ca-certificates \
    tzdata \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -m viewaura

WORKDIR /app

COPY --from=builder /bin/viewaura-worker /app/viewaura-worker

USER viewaura

ENTRYPOINT ["/app/viewaura-worker"]