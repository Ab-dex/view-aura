{
  "name": "@viewaura/email-service",
  "version": "0.1.0",
  "description": "Transactional email service — Kafka consumer → React Email → SendGrid",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build":       "tsc --project tsconfig.json",
    "start":       "node dist/index.js",
    "dev":         "tsx watch src/index.ts",
    "lint":        "eslint src --ext .ts",
    "typecheck":   "tsc --noEmit",
    "preview":     "tsx src/preview.ts",
    "test":        "vitest run"
  },
  "dependencies": {
    "@react-email/components":  "0.0.22",
    "@react-email/render":      "1.0.1",
    "kafkajs":                  "2.2.4",
    "@sendgrid/mail":           "8.1.3",
    "react":                    "18.3.1",
    "zod":                      "3.23.8",
    "pino":                     "9.3.2",
    "pino-pretty":              "11.2.1",
    "dotenv":                   "16.4.5"
  },
  "devDependencies": {
    "@types/react":             "18.3.3",
    "@types/node":              "20.14.11",
    "typescript":               "5.5.3",
    "tsx":                      "4.16.2",
    "vitest":                   "2.0.3",
    "@typescript-eslint/eslint-plugin": "7.16.1",
    "@typescript-eslint/parser": "7.16.1",
    "eslint":                   "8.57.0"
  },
  "engines": {
    "node": ">=20"
  }
}