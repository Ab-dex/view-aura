{
  "name": "@viewaura/graphql-bff",
  "version": "0.1.0",
  "description": "ViewAura GraphQL BFF — Apollo Server 4, DataLoader, subscriptions",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build":      "tsc --project tsconfig.json",
    "start":      "node dist/index.js",
    "dev":        "tsx watch src/index.ts",
    "typecheck":  "tsc --noEmit",
    "lint":       "eslint src --ext .ts",
    "test":       "vitest run",
    "codegen":    "graphql-codegen --config codegen.ts"
  },
  "dependencies": {
    "@apollo/server":                 "4.11.0",
    "@apollo/server/express4":        "*",
    "graphql":                        "16.9.0",
    "graphql-subscriptions":          "2.0.0",
    "graphql-ws":                     "5.16.0",
    "ws":                             "8.18.0",
    "dataloader":                     "2.2.2",
    "express":                        "4.21.0",
    "body-parser":                    "1.20.3",
    "cors":                           "2.8.5",
    "node-fetch":                     "3.3.2",
    "zod":                            "3.23.8",
    "pino":                           "9.3.2",
    "pino-pretty":                    "11.2.1",
    "dotenv":                         "16.4.5",
    "cockatiel":                      "3.1.3"
  },
  "devDependencies": {
    "@types/express":     "4.17.21",
    "@types/cors":        "2.8.17",
    "@types/ws":          "8.5.12",
    "@types/node":        "20.14.11",
    "typescript":         "5.5.3",
    "tsx":                "4.16.2",
    "vitest":             "2.0.3",
    "@graphql-codegen/cli": "5.0.2",
    "@graphql-codegen/typescript": "4.0.9",
    "@graphql-codegen/typescript-resolvers": "4.2.1"
  },
  "engines": { "node": ">=20" }
}